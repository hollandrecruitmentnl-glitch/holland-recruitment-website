{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/herinnering",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.holland-recruitment.nl"
        }
      ],
      "destination": "https://www.holland-recruitment.nl/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.holland-recruitment.nl"
        }
      ],
      "destination": "https://www.holland-recruitment.nl/",
      "permanent": false
    },
    {
      "source": "/voor-werkgevers(\\.html)?",
      "destination": "/voor-bedrijven",
      "permanent": true
    },
    {
      "source": "/voor-werknemers(\\.html)?",
      "destination": "/freelancers",
      "permanent": true
    },
    {
      "source": "/hoe-het-werkt(\\.html)?",
      "destination": "/werkwijze",
      "permanent": true
    },
    {
