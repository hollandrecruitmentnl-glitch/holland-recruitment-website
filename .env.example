# Kopieer naar .env.local (lokaal) of zet in Vercel → Settings → Environment Variables.
# Waarden NOOIT in git. Can vult ze zelf in.

# Postgres (Supabase → Project Settings → Database → Connection string → Transaction pooler, poort 6543)
DATABASE_URL=

# Publieke basis-URL (zonder slash aan het eind)
SITE_URL=https://www.holland-recruitment.nl

# Geheim voor het ondertekenen van cron-aanroepen (Vercel zet CRON_SECRET automatisch mee als Bearer)
CRON_SECRET=

# Bestanden (cv, foto, logo, bijlagen) — Supabase Storage, privé-bucket "platform"
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=platform

# E-mail (Strato, zelfde als de website)
SMTP_HOST=smtp.strato.com
SMTP_PORT=465
SMTP_USER_INFO=
SMTP_PASS_INFO=
SMTP_USER_SALES=
SMTP_PASS_SALES=
# Interne meldingen (nieuwe bemiddelingsaanvraag, opdracht ter controle)
MELDING_INFO=info@holland-recruitment.nl
MELDING_SALES=sales@holland-recruitment.nl

# Opdrachtfeeds
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# KvK-API (optioneel; zonder key alleen formaatcontrole)
KVK_API_KEY=
